# Google OAuth2 Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Optional: Custom redirect URI (defaults to http://localhost:8080)
# Only change if you configured a different URI in Google Cloud Console
# GOOGLE_REDIRECT_URI=http://localhost:8080

# Optional: Additional OAuth2 scopes (space-separated)
# Add any extra Google API scopes beyond the secure defaults
# Example: GOOGLE_ADDITIONAL_SCOPES=https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/contacts
# GOOGLE_ADDITIONAL_SCOPES=

# Optional: try to open a local browser for the first-time OAuth consent flow.
# Defaults to false because this server normally runs inside a container with
# no browser installed - leave this false there and just open the printed
# authorization URL yourself. Only set true if you're running the stdio
# server directly on a host that has a real browser.
# GOOGLE_MCP_OAUTH_OPEN_BROWSER=false

# Optional: interface the local OAuth callback server binds to during the
# first-time consent flow. Defaults to 0.0.0.0 so a published container port
# (docker run -p 8080:8080 ...) can reach it - binding only to localhost
# inside a container is unreachable from your host browser even with the
# port published.
# GOOGLE_MCP_OAUTH_BIND_ADDR=0.0.0.0

# Local OAuth broker experiment (opt-in HTTP runtime)
# Generate secrets locally, for example:
#   python - <<'PY'
#   import secrets
#   print(secrets.token_urlsafe(48))
#   PY
GOOGLE_MCP_BROKER_BOOTSTRAP_SECRET=
GOOGLE_MCP_BROKER_STORAGE_KEY=
GOOGLE_MCP_BROKER_JWT_SIGNING_KEY=
GOOGLE_MCP_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Optional: where the broker persists its encrypted per-connection records
# (the upstream Google refresh token/scopes - NOT the short-lived MCP JWT,
# which stays self-contained). Defaults to "file" so existing deployments
# are unaffected. "memory" is process-local and lost on restart - useful for
# tests/ephemeral runs. "redis" shares state across replicas/restarts.
# GOOGLE_MCP_BROKER_STORE_BACKEND=file

# Required only when GOOGLE_MCP_BROKER_STORE_BACKEND=redis.
# GOOGLE_MCP_BROKER_REDIS_URL=redis://localhost:6379/0